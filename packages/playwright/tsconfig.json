{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@datafactory/*": ["library/datafactory/*"],
      "@helpers/*": ["library/helpers/*"],
      "@fixtures/*": ["library/fixtures/*"],
      "@pages/*": ["library/pages/*"],
      "@shared/*": ["../../shared/*"],
      "@types/*": ["library/types/*"]
    }
  },
  "include": ["tests/**/*", "fixtures/**/*", "playwright.config.ts"]
}
